# Copy to .env and fill in. .env is gitignored -- never commit credentials.

# --- SAP logon (client direction: tools and code execution) ---
RFC_USER=                  # technical RFC user (see abap/README.md for authorizations)
RFC_PASS=
RFC_ASHOST=                # application server host or IP
RFC_SYSNR=00               # system number, e.g. 03
RFC_CLIENT=100             # mandant
RFC_LANG=EN                # logon language (ISO)

# --- Gateway registration (server direction) ---
RFC_GWHOST=                # gateway host, usually the same as RFC_ASHOST
RFC_GWSERV=sapgw00         # sapgw<sysnr>, or the port directly (e.g. 3303)
RFC_PROGID=SAP_AI          # must equal the Program ID of the SM59 T destination

# --- Target system profile ---
# SAP_RELEASE=             # 45B | ECC6; empty = autodetect from RFC_SYSTEM_INFO
# SAP_LANGU=L              # one-character SY-LANGU for RFC_GET_*_P; derived from RFC_LANG when empty (PL -> L)

# --- LLM (OpenAI-compatible) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# LLM_TOOL_CHOICE=auto            # auto | omit | off; vLLM needs --enable-auto-tool-choice --tool-call-parser for tools
# LLM_AUDIT_MODEL=                # defaults to LLM_MODEL
# LLM_TIMEOUT=120
# LLM_MAX_TOOL_ROUNDS=8
# LLM_MAX_OUTPUT_TOKENS=4096
# LLM_HISTORY_MAX_TOKENS=24000
# LLM_STREAM=1                      # 0 = no streaming (servers with poor tool-call streaming)
# LLM_TEMPERATURE=0.2
# LLM_ANSWER_LANGUAGE=EN           # defaults to RFC_LANG
# TOOL_RESULT_MAX_CHARS=12000

# --- Web ---
WEB_HOST=0.0.0.0
WEB_PORT=8765
WEB_PUBLIC_URL=http://curie-host:8765    # handed to SAP -> Chrome; must resolve from end-user PCs

# --- Sessions ---
# SESSION_HEARTBEAT_SEC=3          # returned to SAP as E_HEARTBEAT_SEC
# SESSION_HEARTBEAT_TIMEOUT=15
# BROWSER_TIMEOUT=10
# BROWSER_ATTACH_TIMEOUT=60
# SESSION_IDLE_TIMEOUT=1800
# SESSION_MAX=20
# SESSION_MAX_PER_USER=3
# SESSION_BIND_IP=1               # bind a session to the first browser's IP; 0 behind a proxy
# SESSION_LOG_DIR=logs/sessions

# --- Tools ---
# READ_TABLE_DEFAULT_ROWS=50
# READ_TABLE_MAX_ROWS=500
# READ_TABLE_DENY=USR02,USH02,USR40,USRBF*,PA0*,PCL*
# READ_TABLE_CACHE_TTL=60
# DDIC_CACHE_TTL=3600
# CACHE_MAX_ENTRIES=500           # per cache; LRU eviction; POST /admin/cache/flush from the host flushes
# CACHE_PERSIST=1                 # keep structures, interfaces and domain values on disk between restarts
# CACHE_DIR=cache                 # relative to the project directory
# CACHE_PERSIST_TTL=604800        # seven days; curie --cache purge drops it earlier
# CACHE_SAVE_INTERVAL=60

# --- Knowledge (Markdown notes the model reads; see knowledge/README.md) ---
# KNOWLEDGE_ENABLED=1
# KNOWLEDGE_DIR=knowledge          # relative to curie.py; open it as an Obsidian vault
# KNOWLEDGE_MAX_NOTES=8            # notes per prompt
# KNOWLEDGE_MAX_CHARS=6000         # their total size
# KNOWLEDGE_EXEMPLARS=2            # confirmed programs per prompt
# KNOWLEDGE_CAPTURE_EXEMPLARS=1    # keep confirmed programs that ran
# KNOWLEDGE_CAPTURE_INSIGHTS=1     # learn one-line pitfalls from fixed failures
# KNOWLEDGE_MAX_INSIGHTS=4         # pitfalls per prompt
# KNOWLEDGE_CATALOGUE=1            # replay reports marked correct without the model
# --- languages and customer conventions (curie/lexicon.py, memory/shape.py) ---
# CURIE_LANGUAGES=en,pl            # ISO 639-1 codes of the users' languages; English is always on
# KEY_PATTERN=\b(\d{1,7})/(\d{4})\b   # a document key users write (agreement number/year); one group per part
# KEY_ROLES=nrum:7,rokum:0         # the parts as stored in the tables, with zero padding; they name the family parameters
# VALUE_STOP_CODES=                # upper-case codes in questions that are never data values (column prefixes)
# KNOWLEDGE_FEEDBACK=all          # all | owners | off: whose Correct/Wrong votes change the notes (docs 14)
# KNOWLEDGE_OWNERS=               # SAP users (patterns) whose votes count under owners, e.g. THUPALO,KNOW*
# KNOWLEDGE_REVIEW_INTERVAL=0      # seconds between knowledge reviews in the service; 0 = curie --review-knowledge only
# KNOWLEDGE_REVIEW_APPLY=0         # the job also applies question rewrites and retirements
# KNOWLEDGE_REVIEW_MAX=50          # notes per run
# LLM_GROW_ON_TRUNCATION=1         # retry once with twice the tokens when an answer is cut

# --- ABAP execution ---
# ABAP_EXEC_MODE=job               # job | sync
# ABAP_PROG_PREFIX=ZAI_
# ABAP_RUN_TIMEOUT=300
# ABAP_FIX_RETRIES=3
# ABAP_REQUIRE_CONFIRM=1
# ABAP_AUDIT=1
# ABAP_AUDIT_BLOCKS=1
# ABAP_MAX_SELECT_ROWS=1000
# ABAP_INTERPRET_RESULT=1
# ABAP_CHECK_FM=Z_AI_PROG_CHECK_AND_EXECUTE
# Function modules a generated program may CALL FUNCTION (fnmatch patterns,
# comma separated, case-insensitive). ALLOW always wins over DENY.
# ABAP_FUNCTION_POLICY=deny       # deny: all but ABAP_FUNCTION_DENY | allow: only ABAP_FUNCTION_ALLOW
# ABAP_FUNCTION_DENY=BAPI_TRANSACTION_COMMIT,DB_COMMIT,SXPG_*,RFC_REMOTE_*,TH_*,BAPI_*_CREATE*,BAPI_*_CHANGE*,BAPI_*_DELETE*,BAPI_*_SAVE*,BAPI_*_POST*,BAPI_*_CANCEL*,BAPI_*_RELEASE*,BAPI_*_CONFIRM*,ENQUEUE_*,DEQUEUE_*,JOB_OPEN,JOB_CLOSE,JOB_SUBMIT,BP_*,RSPO_*,SUSR_*,BAPI_USER_*,PRGN_*,ARCHIVE_*,SO_*_SEND*,SCMS_*,GUI_*,WS_*,*_UPLOAD,*_DOWNLOAD,SAPGUI_*,RFC_ABAP_INSTALL_AND_RUN,Z_AI_*
# ABAP_FUNCTION_ALLOW=            # e.g. BAPI_MATERIAL_GET_DETAIL,CONVERSION_EXIT_*,READ_TEXT

# --- Chat plugin: direct SAP -> model calls (Z_BLA_RFC_CHAT_*, Z_AI_CHAT_COMPLETION) ---
# CHAT_PLUGIN=0                    # 1 serves the four function modules on the same Program ID
# CHAT_MODELS=ZGPT-45B=            # logical name=model, comma separated; empty model = LLM_MODEL
# CHAT_MAX_TOKENS=4096
# CHAT_SYSTEM_PROMPT=              # empty = none; "@file.txt" reads a file; {sysid} {client} {language}
# CHAT_READ_WAIT=10                # seconds a READ waits for the first chunk
# CHAT_HANDLE_TTL=300              # seconds without READ before an answer is dropped
# CHAT_MAX_HANDLES=4               # concurrent answers; keep below RFC_REG_COUNT
# CHAT_MAX_INPUT_CHARS=60000
# CHAT_SYNC_TIMEOUT=60             # Z_AI_CHAT_COMPLETION deadline
# CHAT_STREAM_THREADS=0            # 1: one thread and HTTP client per answer

# --- RFC server / SDK; defaults live in config.py ---
# SAPNWRFC720_HOME=C:\nwrfcsdk   # NW RFC SDK 7.20
# RFC_REG_COUNT=3                # gateway registrations = parallel ABAP -> Curie calls
# RFC_CLIENT_POOL=2              # client connections for tool calls
# RFC_DISPATCH_TIMEOUT=5
# RFC_SERVER_TRACE=3             # NW RFC SDK trace level 0-3 (writes rfc*.trc)
# CURIE_LOG_FILE=curie.log       # rotating log file (5 x 5 MB) next to curie.py
# RFC_SAPROUTER=/H/host/S/3299
